Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"

  config.vm.synced_folder "target/jpackage", "/home/vagrant/package", create: true

  config.vm.provision "copy-configuration", type: "file",
    source: "src/test/resources/com/epau/flashcard/app/installer/pages/prefs.xml",
    destination: ".java/.userPrefs/com/epau/app/flashcard/app/installer/pages/prefs.xml"

  config.vm.provision "shell", name: "install-installer", privileged: false, inline: <<-SHELL
    #sudo apt update

    # add to script if necessary:
    # sudo mkdir /usr/share/desktop-directories
    sudo apt purge -y flashcard-app-installer

    cd package
    for deb in $(find -name 'flashcard-app-installer_*_amd64.deb' | sort -r); do
        sudo apt install -y "$deb"
        break
    done
  SHELL

  # TODO
  config.vm.provision "shell", name: "run-installer", privileged: false, inline: <<-SHELL
    cd /opt/flashcard-app-installer/bin

    ./Flashcard\ App \ Installer --cli
  SHELL
end
