Vagrant.configure("2") do |config|
  config.vm.box = "bento/ubuntu-24.04"
  config.vm.box_version = "202510.26.0"

  config.vm.synced_folder "target/jpackage", "/home/vagrant/package", create: true

  #Karaf
  config.vm.network "forwarded_port", guest: 8181, host: 18181, host_ip: "127.0.0.1"

  config.vm.provision "copy-configuration", type: "file", run: "never",
    source: "src/test/resources/prefs.xml",
    destination: ".java/.userPrefs/com/epau/app/flashcard/app/installer/pages/prefs.xml"

   config.vm.provision "shell", name: "apt-setup", privileged: false, inline: <<-SHELL
    sudo apt update
    sudo mkdir /usr/share/desktop-directories
    sudo apt install -y xvfb
    sudo apt install -y expect
   SHELL


  config.vm.provision "shell", name: "install-installer", privileged: false, inline: <<-SHELL
    sudo apt purge -y flashcard-app-installer

    cd package
    for deb in $(find -name 'flashcard-app-installer_*_amd64.deb' | sort -r); do
        sudo apt install -y "$deb"
        break
    done
  SHELL

  config.vm.provision "shell", name: "install-default-config", run: "never", privileged: false, path: "perform-install.sh", args: "--install-default-config"
  config.vm.provision "shell", name: "install-saved-config", run: "never", privileged: false, path: "perform-install.sh", args: "--install-saved-config"

  config.vm.provision "shell", name: "test-assertj", run: "never", privileged: false, inline: <<-SHELL
    cd /opt/flashcard-app-installer/bin

    xvfb-run "./Flashcard App Installer" --test
  SHELL

  config.vm.provision "shell", name: "start-karaf", run: "never", privileged: false, inline: <<-SHELL
    cd /opt/flashcard-app-installer/bin

    "./Flashcard App Installer" --start-karaf
   SHELL
end
