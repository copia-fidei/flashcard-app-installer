<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="com.fes.flashcard.installer.PageFrame">
  <grid id="27dc6" binding="content" layout-manager="GridBagLayout">
    <constraints>
      <xy x="20" y="20" width="968" height="490"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="45533" class="javax.swing.JLabel" binding="pageDescription">
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
          <gridbag top="10" left="10" bottom="10" right="10" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties>
          <text value="&lt;Description&gt;"/>
        </properties>
      </component>
      <component id="1fa62" class="javax.swing.JSeparator">
        <constraints>
          <grid row="1" column="1" row-span="1" col-span="1" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <grid id="bb532" binding="pageContent" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="1.0" weighty="1.0"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children/>
      </grid>
      <component id="35327" class="com.fes.flashcard.installer.ButtonBar" binding="buttonBar">
        <constraints>
          <grid row="4" column="0" row-span="1" col-span="2" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
          <gridbag top="10" left="10" bottom="10" right="10" weightx="1.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <component id="a9589" class="javax.swing.JSeparator">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="2" vsize-policy="6" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="0.0"/>
        </constraints>
        <properties/>
      </component>
      <scrollpane id="ffd30" binding="pageTitleListScrollPane" custom-create="true">
        <constraints>
          <grid row="0" column="0" row-span="4" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
          <gridbag weightx="0.0" weighty="1.0" ipadx="50" ipady="50"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="71bdf" class="com.fes.flashcard.installer.PageTitleList" binding="pageTitleList" custom-create="true">
            <constraints/>
            <properties>
              <enabled value="false"/>
              <model/>
              <valueIsAdjusting value="false"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
